{
  "manifest_version": 3,
  "name": "X-Tracker",
  "version": "1.13.5",
  "description": "Your personal social media intelligence panel. Track accounts, organize lists, and never miss an update.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting",
    "sidePanel",
    "downloads"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://xueqiu.com/*",
    "https://weibo.com/*",
    "https://s.weibo.com/*",
    "https://www.xiaohongshu.com/*",
    "https://xhslink.com/*",
    "https://*.substack.com/*",
    "https://substack.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "X-Tracker",
    "default_icon": {
      "16": "icons/logo-16.png",
      "32": "icons/logo-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/avatar-fallback.svg"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/logo-16.png",
    "32": "icons/logo-32.png",
    "48": "icons/logo-48.png",
    "128": "icons/logo-128.png"
  }
}
